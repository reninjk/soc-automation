# SOC Automation — Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit your actual .env file to version control

# =============================================================
# THREAT INTELLIGENCE APIs
# =============================================================

# VirusTotal API v3
VT_API_KEY=your_virustotal_api_key_here

# AbuseIPDB API v2
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# Additional TI feed API key (e.g. OTX, Shodan, etc.)
TI_FEED_API_KEY=your_ti_feed_api_key_here

# =============================================================
# SIEM INTEGRATION
# =============================================================

SIEM_URL=https://your-siem-instance:8089
SIEM_USERNAME=your_siem_user
SIEM_TOKEN=your_siem_api_token

# =============================================================
# EDR INTEGRATION
# =============================================================

EDR_BASE_URL=https://your-edr-instance/api
EDR_CLIENT_ID=your_edr_client_id
EDR_CLIENT_SECRET=your_edr_client_secret

# =============================================================
# CASE MANAGEMENT
# =============================================================

CASE_MGMT_URL=https://your-case-tool-instance
CASE_MGMT_API_KEY=your_case_mgmt_api_key
CASE_MGMT_PROJECT=SOC

# =============================================================
# NOTIFICATIONS
# =============================================================

# Chat webhook (Slack, Teams, etc.)
CHAT_WEBHOOK_URL=https://your-chat-platform/webhook/url
SOC_ALERT_CHANNEL=#soc-alerts
SOC_CRITICAL_CHANNEL=#soc-critical

# PagerDuty / on-call integration
ONCALL_INTEGRATION_KEY=your_oncall_integration_key

# Email (SMTP)
SMTP_HOST=smtp.your-org.com
SMTP_PORT=587
SMTP_USERNAME=soc-automation@your-org.com
SMTP_PASSWORD=your_smtp_password
SOC_ALERT_RECIPIENTS=soc-team@your-org.com

# =============================================================
# FIREWALL / NETWORK CONTROL
# =============================================================

FIREWALL_HOST=your-firewall.your-org.com
FIREWALL_API_KEY=your_firewall_api_key

# =============================================================
# APPLICATION SETTINGS
# =============================================================

LOG_LEVEL=INFO
LOG_FORMAT=json
ENVIRONMENT=production

API_RATE_LIMIT_DELAY=1
DEDUP_WINDOW_MINUTES=15
P1_AUTO_ESCALATE=true
FP_SUPPRESSION_ENABLED=true

REPORT_OUTPUT_DIR=/opt/soc/reports

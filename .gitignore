# =============================================================
# SOC Automation — .gitignore
# =============================================================

# ── Secrets & Credentials ────────────────────────────────────
.env
.env.local
.env.*.local
*.key
*.pem
*.p12
*.pfx
secrets/
credentials/

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg
.venv/
venv/
env/
ENV/
.pytest_cache/
.coverage
htmlcov/
.tox/
*.log

# ── IDEs & Editors ───────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Reports & Output ─────────────────────────────────────────
/reports/output/
*.csv
*.xlsx
*.pdf

# ── OS ───────────────────────────────────────────────────────
.DS_Store
desktop.ini
